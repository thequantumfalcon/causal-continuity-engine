{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thequantumfalcon/causal-continuity-engine/v0.2.0/schemas/cce.resume.v2.json",
  "title": "CCE Resume Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "generated_at",
    "project_state_at",
    "project_state_basis",
    "target",
    "mission",
    "authority",
    "accepted_decisions",
    "verified_progress",
    "invalidations",
    "assumptions",
    "open_work",
    "environment",
    "trust",
    "continuity_lineage",
    "evidence_index",
    "evidence_coverage",
    "omissions",
    "recent_context",
    "token_estimate",
    "packet_digest",
    "tenant_id",
    "project_id",
    "scope",
    "complete",
    "mandatory_control",
    "authority_set_digest",
    "max_response_bytes",
    "response_format"
  ],
  "properties": {
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "description": "Requested cap for the declared response format; the producing transport measures its actual encoded output."
    },
    "response_format": {
      "enum": [
        "engine-json",
        "engine-markdown",
        "cli-json",
        "cli-markdown",
        "http-json",
        "mcp-json",
        "mcp-markdown"
      ]
    },
    "schema_version": {
      "const": "cce.resume.v2"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^rsp_[0-9a-f]{24}$"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "project_state_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "project_state_basis": {
      "description": "Engine-captured state and external artifact commitment.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_seq",
            "control_basis_digest",
            "artifact_inputs"
          ],
          "properties": {
            "event_seq": {
              "type": "integer",
              "minimum": 0
            },
            "control_basis_digest": {
              "$ref": "#/$defs/sha256"
            },
            "artifact_inputs": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "objective",
        "target",
        "pinned_control_state",
        "retired_control_state"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string"
        },
        "target": {
          "type": "object"
        },
        "pinned_control_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "retired_control_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_precedence",
        "active_requirements",
        "active_constraints"
      ],
      "properties": {
        "instruction_precedence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "active_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        }
      }
    },
    "accepted_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "verified_progress": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "invalidations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invalidation"
      }
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "uncertain"
      ],
      "properties": {
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "uncertain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        }
      }
    },
    "open_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "blockers",
        "next_safe_action"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "next_safe_action": {
          "oneOf": [
            {
              "$ref": "#/$defs/summary"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary"
              ],
              "properties": {
                "summary": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "environment": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      ]
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "autonomy_level",
        "required_verifiers",
        "completed_checks",
        "failed_or_stale_checks",
        "gaps"
      ],
      "properties": {
        "policy": {
          "type": "object"
        },
        "autonomy_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "required_verifiers": {
          "$ref": "#/$defs/stringList"
        },
        "completed_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "failed_or_stale_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "gaps": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "continuity_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_session",
        "checkpoints",
        "packet_generation_time"
      ],
      "properties": {
        "source_session": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoints": {
          "$ref": "#/$defs/identifierList"
        },
        "packet_generation_time": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/identifier"
          },
          "evidence_ids": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "evidence_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recent_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "entity_type",
          "summary",
          "score"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/identifier"
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "token_estimate": {
      "type": "integer",
      "minimum": 0
    },
    "packet_digest": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "tenant_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "scope": {
      "$ref": "#/$defs/packetScope"
    },
    "complete": {
      "const": true
    },
    "mandatory_control": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mandatoryControl"
      }
    },
    "authority_set_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}(?![\\s\\S])"
    },
    "identifierList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "entity_type",
        "status",
        "criticality",
        "confidence",
        "authority",
        "summary"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "criticality": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalidation_id",
        "status",
        "trigger_type",
        "target",
        "severity",
        "affected_count",
        "minimal_causal_path",
        "recommended_action"
      ],
      "properties": {
        "invalidation_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "minimal_causal_path": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "recommended_action": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "value"
          ],
          "properties": {
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "algorithm": {
              "const": "hmac-sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "fingerprint",
            "public_key",
            "value"
          ],
          "properties": {
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "algorithm": {
              "const": "lamport-sha256/1"
            },
            "fingerprint": {
              "$ref": "#/$defs/sha256"
            },
            "public_key": {
              "type": "array",
              "minItems": 256,
              "maxItems": 256,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "value": {
              "type": "array",
              "minItems": 256,
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "packetScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "project"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id"
          ],
          "properties": {
            "kind": {
              "const": "task"
            },
            "task_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "authorityScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "global"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "task_ids"
          ],
          "properties": {
            "kind": {
              "const": "tasks"
            },
            "task_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "confirmation_event_id",
        "decision_event_id",
        "authority_version"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/identifier"
        },
        "confirmation_event_id": {
          "$ref": "#/$defs/identifier"
        },
        "decision_event_id": {
          "$ref": "#/$defs/identifier"
        },
        "authority_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mandatoryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "entity_type",
        "origin",
        "status",
        "criticality",
        "confidence",
        "authority",
        "valid_from",
        "valid_to",
        "authority_scope",
        "content",
        "confirmation"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_type": {
          "enum": [
            "requirement",
            "constraint",
            "decision",
            "assumption"
          ]
        },
        "origin": {
          "enum": [
            "confirmed",
            "runtime"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "criticality": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "authority_scope": {
          "$ref": "#/$defs/authorityScope"
        },
        "content": {
          "type": "object"
        },
        "confirmation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/confirmation"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "confirmation": {
                "$ref": "#/$defs/confirmation"
              }
            }
          },
          "else": {
            "properties": {
              "confirmation": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "v0.2.0 contract. This schema validates the byte-limit declaration, not the length of an external response. Runtime validation additionally checks canonical member ordering, unique node identities, task applicability, and authority-set digest equality."
}
