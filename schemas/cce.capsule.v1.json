{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thequantumfalcon/causal-continuity-engine/v0.1.0/schemas/cce.capsule.v1.json",
  "title": "CCE Session Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capsule_id", "created_at", "tenant_id", "project_id",
    "source", "target", "resume_packet", "observable_state", "lineage",
    "content_digest", "signature"
  ],
  "properties": {
    "schema_version": {"const": "cce.capsule.v1"},
    "capsule_id": {"type": "string", "pattern": "^cap_[0-9a-f]{24}$"},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "model", "runtime"],
      "properties": {
        "session_id": {
          "oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "model": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1}
      }
    },
    "resume_packet": {
      "$ref": "https://raw.githubusercontent.com/thequantumfalcon/causal-continuity-engine/v0.1.0/schemas/cce.resume.v1.json"
    },
    "observable_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_assumptions", "open_invalidations"],
      "properties": {
        "active_assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id", "statement", "status", "criticality", "confidence"
            ],
            "properties": {
              "node_id": {"$ref": "#/$defs/identifier"},
              "statement": {"type": ["string", "null"]},
              "status": {
                "enum": ["active", "supported", "uncertain"]
              },
              "criticality": {"type": ["string", "null"], "minLength": 1},
              "confidence": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "open_invalidations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exported_from_session", "event_watermark"],
      "properties": {
        "exported_from_session": {
          "oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "event_watermark": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "$ref": "https://raw.githubusercontent.com/thequantumfalcon/causal-continuity-engine/v0.1.0/schemas/cce.resume.v1.json#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}
  },
  "not": {
    "anyOf": [
      {"required": ["chain_of_thought"]},
      {"required": ["hidden_reasoning"]},
      {"required": ["reasoning_trace"]},
      {"required": ["internal_monologue"]},
      {"required": ["scratchpad"]},
      {"required": ["thinking"]}
    ]
  }
}
